{
  "name": "Sonicos WhatsApp Bot",
  "description": "A Go WhatsApp bot built with whatsmeow, SQLite, and Redis.",
  "repository": "https://github.com/SafwanGanz/Sonicos",
  "keywords": ["go", "whatsapp", "whatsmeow", "sqlite", "redis"],
  "stack": "container",
  "env": {
    "DATABASE_DRIVER": {
      "description": "Whatsmeow session database driver.",
      "value": "sqlite3"
    },
    "DATABASE_URL": {
      "description": "SQLite file URL for the WhatsApp linked-device session.",
      "value": "file:./data/sonicos.db?_foreign_keys=on&_journal_mode=WAL&_busy_timeout=5000"
    },
    "REDIS_URL": {
      "description": "Redis connection URL. Use a managed Redis-compatible service.",
      "required": true
    },
    "BOT_PREFIX": {
      "description": "Prefix used to invoke commands.",
      "value": "!"
    },
    "WORKERS": {
      "description": "Concurrent command workers.",
      "value": "8"
    },
    "QUEUE_SIZE": {
      "description": "Maximum buffered incoming messages.",
      "value": "512"
    },
    "LOG_LEVEL": {
      "description": "Application log level.",
      "value": "info"
    }
  },
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "basic"
    }
  }
}
