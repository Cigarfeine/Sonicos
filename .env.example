# Database configuration ("sqlite3" or "pgx")
DATABASE_DRIVER=sqlite3
DATABASE_URL=file:./data/sonicos.db?_foreign_keys=on&_journal_mode=WAL&_busy_timeout=5000

# Redis connection URL for command idempotency
REDIS_URL=redis://localhost:6379/0

# Bot command prefix
BOT_PREFIX=!

# Worker pool settings
WORKERS=8
QUEUE_SIZE=512

# Web onboarding & dashboard password (alphanumeric or numeric).
# Leave empty on local PC/VPS to keep the web dashboard disabled (terminal QR only).
# Set a strong password on Railway/Heroku to enable the protected web dashboard.
DASHBOARD_PASSWORD=

# HTTP port for the web dashboard (default 8080; set automatically by Railway/Heroku)
# PORT=8080

# Optional comma-separated list of extra allowed CORS origins (same-origin is always allowed)
# CORS_ALLOWED_ORIGINS=
# Logging level ("debug", "info", "warn", "error")
LOG_LEVEL=info

# Optional path to ffmpeg binary (defaults to "ffmpeg" in PATH)
FFMPEG_PATH=ffmpeg
